{
  "auto-audit": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "../scripts/auto-audit.sh --hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "knowledge-sync": {
    "Stop": [
      {
        "type": "command",
        "command": "../scripts/knowledge-sync.py --stop-hook",
        "timeout": 20
      }
    ]
  }
}
