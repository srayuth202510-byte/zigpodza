{
  "profile": "sandbox",
  "max_memory_bytes": 268435456,
  "max_pids_limit": 64,
  "require_read_only": true,
  "require_no_new_privileges": true,
  "require_cap_drop_all": true,
  "forbid_cap_add": true,
  "forbid_rw_mounts": true,
  "forbid_published_ports": false,
  "allowed_networks": ["none"],
  "tmpfs_tmp_options": "rw,noexec,nosuid,nodev,size=67108864"
}
